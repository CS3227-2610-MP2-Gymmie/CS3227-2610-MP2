<?xml version="1.0" encoding="UTF-8"?>
<?import gymmie.ui.StatusLabel?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
        stylesheets="@../css/gymmie.css"
        fitToWidth="true" minWidth="0" fitToHeight="true" fx:controller="gymmie.DashboardController">
    <VBox spacing="18" styleClass="page">
        <Label fx:id="title" styleClass="title" wrapText="true" minWidth="0" />
        <Label fx:id="welcome" wrapText="true" minWidth="0" minHeight="-Infinity" maxWidth="Infinity" />
        <VBox fx:id="actions" spacing="18">
            <VBox spacing="10" styleClass="card" maxWidth="720">
                <Label text="My profile" styleClass="heading" wrapText="true" minWidth="0" />
                <Label fx:id="profileDetails" wrapText="true" minWidth="0"
                        minHeight="-Infinity" maxWidth="Infinity" />
                <VBox fx:id="trainerDetails" spacing="10" visible="false" managed="false">
                    <Label text="Synopsis" styleClass="heading" />
                    <Label fx:id="trainerSynopsis" wrapText="true" minWidth="0"
                            minHeight="-Infinity" maxWidth="Infinity" />
                    <Label text="Training specializations" styleClass="heading" />
                    <Label fx:id="trainerSpecializations" wrapText="true" minWidth="0"
                            minHeight="-Infinity" maxWidth="Infinity" />
                    <StatusLabel fx:id="trainerDetailsStatus" minHeight="-Infinity" />
                </VBox>
                <Label text="Your username and role are managed by your gym." styleClass="helper" wrapText="true" minWidth="0" />
                <Button fx:id="profileButton" text="Edit my _profile" onAction="#editProfile" />
            </VBox>
            <VBox fx:id="displayNameSection" maxWidth="720" spacing="10" styleClass="card">
                <Label text="Change display name" styleClass="heading" wrapText="true" minWidth="0" />
                <Label text="Choose a name of 1–100 characters. This is the name others see."
                        styleClass="helper" wrapText="true" minWidth="0" />
                <Label text="_Display name" mnemonicParsing="true" labelFor="${ownDisplayName}" />
                <TextField fx:id="ownDisplayName" onAction="#changeDisplayName" />
                <Button id="saveDisplayNameButton" text="Save display _name" onAction="#changeDisplayName" />
                <StatusLabel fx:id="displayNameStatus" minHeight="-Infinity" />
            </VBox>
            <VBox maxWidth="720" spacing="10" styleClass="card">
                <Label text="Change password" styleClass="heading" wrapText="true" minWidth="0" />
                <Label text="Choose a password of 8–128 characters." styleClass="helper" wrapText="true" minWidth="0" />
                <Label text="_Current password" mnemonicParsing="true" labelFor="${currentPassword}" wrapText="true" minWidth="0" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <PasswordField fx:id="currentPassword" />
                    <Button fx:id="currentPasswordReveal" text="Show" styleClass="button, reveal-button" />
                </HBox>
                <Label text="_New password" mnemonicParsing="true" labelFor="${newPassword}" wrapText="true" minWidth="0" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <PasswordField fx:id="newPassword" />
                    <Button fx:id="newPasswordReveal" text="Show" styleClass="button, reveal-button" />
                </HBox>
                <Label text="Con_firm new password" mnemonicParsing="true" labelFor="${confirmPassword}" wrapText="true" minWidth="0" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <PasswordField fx:id="confirmPassword" onAction="#changePassword" />
                    <Button fx:id="confirmPasswordReveal" text="Show" styleClass="button, reveal-button" />
                </HBox>
                <Button id="savePasswordButton" text="_Save password" onAction="#changePassword" />
            </VBox>
        </VBox>
        <StatusLabel fx:id="status" />
    </VBox>
</ScrollPane>
