<?xml version="1.0" encoding="UTF-8"?>
<?import gymmie.ui.StatusLabel?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
        stylesheets="@../css/gymmie.css"
        fitToWidth="true" minWidth="0" fitToHeight="true" fx:controller="gymmie.LoginController">
    <VBox alignment="CENTER" spacing="24" styleClass="page">
        <Label text="GYMMIE" styleClass="brand" wrapText="true" minWidth="0" />
        <VBox maxWidth="400" spacing="16" styleClass="card">
            <Label text="Welcome back" styleClass="title" wrapText="true" minWidth="0" />
            <Label text="Log in to your gym workspace." styleClass="helper" wrapText="true" minWidth="0" />
            <VBox fx:id="form" spacing="10">
                <Label text="_Username" mnemonicParsing="true" labelFor="${username}" wrapText="true" minWidth="0" />
                <TextField fx:id="username" onAction="#login" />
                <Label text="_Password" mnemonicParsing="true" labelFor="${password}" wrapText="true" minWidth="0" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <PasswordField fx:id="password" onAction="#login" />
                    <Button fx:id="passwordReveal" text="Show" styleClass="button, reveal-button" />
                </HBox>
                <Button text="_Log in" defaultButton="true"
                        maxWidth="Infinity" onAction="#login" />
            </VBox>
            <StatusLabel fx:id="status" />
        </VBox>
    </VBox>
</ScrollPane>
