<?xml version="1.0" encoding="UTF-8"?>
<?import gymmie.ui.StatusLabel?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
        fitToWidth="true" minWidth="0" stylesheets="@../../css/gymmie.css,@../css/accounts.css"
        fx:controller="gymmie.manager.ManagerAccountsController">
    <VBox spacing="18" styleClass="page, accounts-page">
        <Label text="Account management" styleClass="title" wrapText="true" minWidth="0" />
        <Button fx:id="backButton" text="_Back to dashboard" onAction="#back" />
        <Button fx:id="refreshButton" text="_Refresh" onAction="#refresh" />
        <StatusLabel fx:id="status" />

        <VBox maxWidth="900" spacing="10" styleClass="card">
            <Label fx:id="formHeading" text="Provision new account" styleClass="heading" wrapText="true" minWidth="0" />
            <Label text="_Username (3–30 characters)" mnemonicParsing="true" labelFor="${accountUsername}" wrapText="true" minWidth="0" />
            <TextField fx:id="accountUsername" promptText="e.g. john_trainer" onAction="#saveAccount" />
            <Label fx:id="passwordLabel" text="_Password (8–128 characters)" mnemonicParsing="true" labelFor="${accountPassword}" wrapText="true" minWidth="0" />
            <HBox fx:id="passwordBox" spacing="10" alignment="CENTER_LEFT">
                <PasswordField fx:id="accountPassword" onAction="#saveAccount" />
                <Button fx:id="accountPasswordReveal" text="Show" styleClass="button, reveal-button" />
            </HBox>
            <Label text="_Display name (1–100 characters)" mnemonicParsing="true" labelFor="${accountDisplayName}" wrapText="true" minWidth="0" />
            <TextField fx:id="accountDisplayName" promptText="e.g. John Doe" onAction="#saveAccount" />
            <Label fx:id="roleLabel" text="_Role" mnemonicParsing="true" labelFor="${accountRole}" wrapText="true" minWidth="0" />
            <ComboBox fx:id="accountRole" maxWidth="Infinity" />
            <FlowPane hgap="10" vgap="10">
                <Button fx:id="saveAccountButton" text="_Provision account" onAction="#saveAccount" />
                <Button fx:id="cancelEditButton" text="_Cancel edit" onAction="#cancelEdit"
                        visible="false" managed="false" />
            </FlowPane>
        </VBox>

        <Label text="All accounts" styleClass="heading" wrapText="true" minWidth="0" />
        <VBox fx:id="accountList" spacing="12" maxWidth="900" />
    </VBox>
</ScrollPane>
