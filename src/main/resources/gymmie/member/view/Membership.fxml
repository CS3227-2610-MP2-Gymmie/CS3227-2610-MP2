<?xml version="1.0" encoding="UTF-8"?>
<?import gymmie.ui.StatusLabel?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
        fitToWidth="true" minWidth="0" stylesheets="@../../css/gymmie.css,@../css/membership.css"
        fx:controller="gymmie.member.MemberMembershipController">
    <VBox fx:id="membershipScreen" spacing="18" styleClass="page, membership-page">
        <Label text="My membership" styleClass="title" wrapText="true" minWidth="0" />
        <Button id="backButton" text="_Back to dashboard" onAction="#back" />
        <VBox maxWidth="900" spacing="10" styleClass="card">
            <Label text="Current membership" styleClass="heading" wrapText="true" minWidth="0" />
            <StatusLabel fx:id="membershipStatus" styleClass="status, membership-state" minHeight="-Infinity" />
            <Label fx:id="membershipPlan" text="Plan: —" styleClass="membership-plan" wrapText="true" minWidth="0" />
            <Label fx:id="membershipExpiry" text="Expiry date: —" wrapText="true" minWidth="0" />
            <Button fx:id="refreshMembership" text="_Refresh" onAction="#refreshMembership" />
            <Button fx:id="renewMembership" text="_Renew current plan" onAction="#renewMembership"
                    disable="true" />
            <Button fx:id="cancelMembership" text="_Cancel current membership" onAction="#cancelMembership"
                    disable="true" />
            <StatusLabel fx:id="renewalStatus" minHeight="-Infinity" />
            <StatusLabel fx:id="cancellationStatus" minHeight="-Infinity" />
        </VBox>
        <VBox maxWidth="900" spacing="10" styleClass="card">
            <Label text="Buy a membership" styleClass="heading" wrapText="true" minWidth="0" />
            <Label text="Choose an available plan. Price and duration are saved with your purchase." styleClass="helper"
                   wrapText="true" minWidth="0" />
            <ComboBox fx:id="availablePlans" maxWidth="Infinity" accessibleText="Available membership plans" />
            <Button fx:id="refreshPlans" text="_Refresh plans" onAction="#refreshAvailablePlans" />
            <Button fx:id="purchaseMembership" text="_Purchase membership" onAction="#purchaseMembership"
                    disable="true" />
            <StatusLabel fx:id="purchaseStatus" />
        </VBox>
    </VBox>
</ScrollPane>
