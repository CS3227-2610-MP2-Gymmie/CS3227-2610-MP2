<?xml version="1.0" encoding="UTF-8"?>
<?import gymmie.ui.StatusLabel?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
        fitToWidth="true" minWidth="0" stylesheets="@../../css/gymmie.css"
        fx:controller="gymmie.trainer.CreateSessionController">
    <VBox spacing="18" styleClass="page">
        <Label fx:id="title" text="Create session" styleClass="title" wrapText="true" minWidth="0" />
        <Button fx:id="backButton" text="_Back to dashboard" onAction="#back" />
        <StatusLabel fx:id="status" />
        <VBox fx:id="form" spacing="12" maxWidth="900" styleClass="card">
            <Label fx:id="introduction" text="Schedule a session for Members. You will be its Trainer." styleClass="helper" wrapText="true" minWidth="0" />
            <Label text="Start _date" mnemonicParsing="true" labelFor="${startDate}" wrapText="true" minWidth="0" />
            <DatePicker fx:id="startDate" editable="false" promptText="Choose a date" maxWidth="Infinity" />
            <Label text="_Start time" mnemonicParsing="true" labelFor="${startTime}" wrapText="true" minWidth="0" />
            <TextField fx:id="startTime" promptText="HH:mm (e.g. 14:30)" onAction="#save" />
            <Label text="Use 24-hour local system time. The start must be in the future." styleClass="helper" wrapText="true" minWidth="0" />
            <Label text="D_uration (minutes)" mnemonicParsing="true" labelFor="${duration}" wrapText="true" minWidth="0" />
            <TextField fx:id="duration" promptText="15–240" onAction="#save" />
            <Label text="_Capacity (Members)" mnemonicParsing="true" labelFor="${capacity}" wrapText="true" minWidth="0" />
            <TextField fx:id="capacity" promptText="1–50" onAction="#save" />
            <Label text="D_escription (optional)" mnemonicParsing="true" labelFor="${description}" wrapText="true" minWidth="0" />
            <TextArea fx:id="description" wrapText="true" prefRowCount="3"
                      promptText="Enter a session description (optional)"
                      style="-fx-border-color: #727e76; -fx-border-width: 1px; -fx-border-radius: 4px;" />
            <Button fx:id="saveButton" text="C_reate session" onAction="#save" />
        </VBox>
    </VBox>
</ScrollPane>
